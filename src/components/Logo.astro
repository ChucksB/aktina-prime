---
interface Props {
  size?: "sm" | "md" | "lg";
  asLink?: boolean;
}
const { size = "sm", asLink = true } = Astro.props;

const heightMap = {
  sm: "h-10 md:h-11",
  md: "h-16 md:h-20",
  lg: "h-24 md:h-32",
};

const classes = `inline-flex items-center ${heightMap[size]}`;
---

{asLink ? (
  <a href="/" class={classes} aria-label="Aktina Prime — Home">
    <img
      src="/logo.png"
      alt="Aktina Prime"
      class="h-full w-auto block select-none"
      style="image-rendering: -webkit-optimize-contrast;"
      draggable="false"
    />
  </a>
) : (
  <span class={classes} aria-label="Aktina Prime">
    <img
      src="/logo.png"
      alt="Aktina Prime"
      class="h-full w-auto block select-none"
      style="image-rendering: -webkit-optimize-contrast;"
      draggable="false"
    />
  </span>
)}
