---
import Logo from "./Logo.astro";

const socials = [
  { label: "Instagram", handle: "@aktinaprime", href: "https://instagram.com/aktinaprime" },
  { label: "X / Twitter", handle: "@aktinaprime", href: "https://twitter.com/aktinaprime" },
  { label: "LinkedIn", handle: "Aktina Prime Global Services Limited", href: "https://linkedin.com/company/aktinaprime" },
  { label: "YouTube", handle: "Aktina Prime", href: "https://youtube.com/@aktinaprime" },
];

const year = new Date().getFullYear();
---

<footer
  class="bg-[color:var(--color-canvas)] mt-16"
  style="box-shadow: inset 0 1px 0 var(--color-line-strong);"
>
  <div class="container-x py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <Logo size="md" asLink={false} />
        <p class="mt-5 text-[1rem] leading-[1.55] text-[color:var(--color-muted)] max-w-sm">
          Where technology meets creative power. A multi-disciplinary studio building products, producing media, and engineering presence.
        </p>
      </div>

      <div class="md:col-span-7 grid grid-cols-2 gap-8">
        <div>
          <div class="eyebrow mb-4"><span class="num">01</span><span>Studio</span></div>
          <ul class="space-y-3">
            <li><a class="link text-[0.9375rem]" href="#tech">Technology</a></li>
            <li><a class="link text-[0.9375rem]" href="#media">Media</a></li>
            <li><a class="link text-[0.9375rem]" href="#publicity">Publicity</a></li>
            <li><a class="link text-[0.9375rem]" href="#founder">Founder</a></li>
          </ul>
        </div>

        <div>
          <div class="eyebrow mb-4"><span class="num">02</span><span>Follow</span></div>
          <ul class="space-y-3">
            {socials.map((s) => (
              <li>
                <a class="link text-[0.9375rem]" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <hr class="rule my-12" />

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-[0.8125rem] text-[color:var(--color-muted)]">
      <p>© {year} Aktina Prime Global Services Limited. All rights reserved.</p>
      <p class="font-medium tracking-[0.08em] uppercase">Lagos &nbsp;·&nbsp; Worldwide</p>
    </div>
  </div>
</footer>
