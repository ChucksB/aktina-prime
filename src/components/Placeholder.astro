---
interface Props {
  ratio?: "16/10" | "4/3" | "1/1" | "3/4" | "16/9" | "21/9";
  label?: string;
  class?: string;
}
const { ratio = "16/10", label = "PLACEHOLDER", class: classList = "" } = Astro.props;
---

<div class={`placeholder ${classList}`} style={`aspect-ratio: ${ratio};`}>
  <span class="placeholder-label">{label}</span>
</div>
