---
import Reveal from "../Reveal.tsx";
import WordReveal from "../WordReveal.tsx";
import ContactForm from "../ContactForm.tsx";
---

<section id="contact" class="section-y">
  <div class="container-x">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
      <Reveal client:visible className="lg:col-span-7 col-span-1">
        <div class="eyebrow"><span class="num">07</span><span>Connect</span></div>
        <h2 class="font-display font-semibold text-[clamp(3rem,9vw,7.5rem)] leading-[0.95] tracking-[-0.025em] mt-6">
          <WordReveal
            client:visible
            words={["Let's build", "something"]}
            brandPeriod={true}
            ariaLabel="Let's build something."
          />
        </h2>

        <p class="body-lg mt-8" style="color: var(--color-muted);">
          Whether you are looking for a technology partner, a creative production team, or a publicity powerhouse, Aktina Prime is ready. Tell us about the project and we will reply within one working day.
        </p>
      </Reveal>

      <Reveal client:visible className="lg:col-span-5 col-span-1">
        <ContactForm client:visible />
      </Reveal>
    </div>
  </div>
</section>
